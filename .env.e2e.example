# Mot de passe commun des comptes de démonstration (seed) et des tests de bout en bout réels.
# Copier en .env.e2e (gitignoré, chmod 600) et générer une valeur aléatoire :
#   printf 'SEED_PASSWORD=%s\n' "$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)" > .env.e2e && chmod 600 .env.e2e
SEED_PASSWORD=
