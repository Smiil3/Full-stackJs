# Uniquement des variables VITE_* NON sensibles : tout ce qui est ici finit dans le bundle public.
# Base de l'API (chemin relatif : passe par le proxy Vite en dev).
VITE_API_BASE_URL=/api/v1
# Origine du prestataire de paiement : seule destination externe vers laquelle le front redirige.
VITE_PSP_ORIGIN=http://localhost:4001
# Clé PUBLIQUE Ed25519 des billets (JWK, non sensible), épinglée pour le contrôle hors-ligne.
# Obligatoire en production (build refusé sinon) ; facultative en développement. Obtention : npm run ticket-key
# VITE_TICKET_PUBLIC_KEY_JWK={"kty":"OKP","crv":"Ed25519","x":"..."}
