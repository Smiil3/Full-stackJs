# ---------------------------------------------------------------------------
# Billetterie « Les Nuits de la Garonne » — variables d'environnement backend
# Copier en `.env` (jamais commité) puis renseigner TOUS les secrets vides ci-dessous.
# Chaque secret doit être DIFFÉRENT. Générer une valeur (256 bits, base64url) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Clé de chiffrement (exactement 32 octets, base64 standard) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# L'API refuse de démarrer si une variable manque, si un secret est trop court,
# s'il contient une valeur d'exemple (CHANGE_ME) ou s'il est identique à un autre.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
# Port HTTP de l'API
PORT=4000
# Niveau de log pino : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL — remplacer <mot_de_passe> (voir ../docker-compose.yml en dev)
DATABASE_URL=postgresql://nuits:<mot_de_passe>@127.0.0.1:5432/nuits
# Base dédiée aux tests, obligatoire pour `npm test` : son nom DOIT finir par _test (vidée entre chaque test)
TEST_DATABASE_URL=postgresql://nuits:<mot_de_passe>@127.0.0.1:5433/nuits_test

# URL publique du frontend : seule origine autorisée (CORS + anti-CSRF) et base des liens envoyés par mail
FRONT_URL=http://localhost:5173
# URL publique de l'API (liens de redirection du PSP)
API_PUBLIC_URL=http://localhost:4000
# Nombre de proxys de confiance devant l'API (0 à 3). 0 = API exposée directement ;
# 1 = un reverse proxy (nginx, load balancer) qui ÉCRASE X-Forwarded-For. Une valeur trop haute
# permet à un client de choisir son IP (contournement du rate limiting) : mettre le nombre exact.
TRUST_PROXY_HOPS=0

# JWT d'accès (HS256) : secret aléatoire base64url décodant en ≥ 32 octets
JWT_ACCESS_SECRET=
# Identifiant de la clé courante (en-tête `kid` du JWT) et anciens secrets acceptés pendant une rotation
JWT_KEY_ID=k1
JWT_PREVIOUS_SECRETS=
JWT_ISSUER=nuits-api
JWT_AUDIENCE=nuits-web
# Cookie du refresh token avec l'attribut Secure (OBLIGATOIREMENT true en production ; false seulement en dev HTTP)
REFRESH_COOKIE_SECURE=false

# Chiffrement au repos des IBAN (AES-256-GCM) : exactement 32 octets encodés en base64
DATA_ENCRYPTION_KEY=
# Identifiant de la clé courante (inscrit dans chaque chiffré, permet la rotation)
DATA_ENCRYPTION_KEY_ID=k1
# Rotation : anciennes clés encore acceptées en déchiffrement, "kid:base64,kid:base64" (vide par défaut)
DATA_ENCRYPTION_PREVIOUS_KEYS=

# Clés Ed25519 de signature des billets (générées par `npm run keys:generate`, dossier gitignoré)
TICKET_SIGNING_PRIVATE_KEY_FILE=keys/ticket-signing-private.pem
TICKET_SIGNING_PUBLIC_KEY_FILE=keys/ticket-signing-public.pem

# SMTP (Mailpit en dev : UI sur http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# STARTTLS exigé (port 587). En production : SMTP_SECURE=true (port 465) OU SMTP_REQUIRE_TLS=true, obligatoire.
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Les Nuits de la Garonne <billetterie@nuits-garonne.test>"

# Prestataire de paiement (mock en dev/test, jamais démarré en production)
PSP_BASE_URL=http://localhost:4001
PSP_PORT=4001
# Clé d'API backend -> PSP (base64url, ≥ 32 octets)
PSP_API_KEY=
# Secret HMAC des webhooks PSP -> backend (base64url, ≥ 32 octets, différent de PSP_API_KEY)
PSP_WEBHOOK_SECRET=
# URL de webhook appelée par le mock PSP
PSP_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/psp

# Temps de réponse minimal (ms) de register / forgot-password / resend-verification (anti-oracle de timing, ≥ 300)
AUTH_RESPONSE_FLOOR_MS=400

# Multiplicateur des plafonds de rate limiting (1 = valeurs de production). Une valeur > 1 n'est utile
# qu'en dev / e2e (tous les tests viennent de la même IP) et est REFUSÉE en production.
RATE_LIMIT_MULTIPLIER=1

# Worker : période de scrutation (expirations, outbox mail, remboursements), en ms
WORKER_INTERVAL_MS=5000

# Seed : mot de passe commun des comptes de démonstration, ≥ 16 caractères.
# Laisser vide pour qu'un mot de passe aléatoire soit généré et affiché une seule fois.
# Le seed refuse de s'exécuter si DATABASE_URL ne pointe pas sur localhost / 127.0.0.1.
SEED_PASSWORD=
