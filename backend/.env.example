# ---------------------------------------------------------------------------
# Billetterie « Les Nuits de la Garonne » — variables d'environnement backend
# Copier en `.env` (jamais commité) puis remplacer TOUS les secrets :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# L'API refuse de démarrer si une variable manque ou si un secret est trop court.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
# Port HTTP de l'API
PORT=4000
# Niveau de log pino : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL (voir ../docker-compose.yml)
DATABASE_URL=postgresql://nuits:CHANGE_ME@127.0.0.1:5432/nuits
# Base dédiée aux tests (vidée entre chaque test) — obligatoire pour `npm test`
TEST_DATABASE_URL=postgresql://nuits:CHANGE_ME@127.0.0.1:5433/nuits_test

# URL publique du frontend : seule origine autorisée (CORS + anti-CSRF) et base des liens envoyés par mail
FRONT_URL=http://localhost:5173
# URL publique de l'API (liens de redirection du PSP)
API_PUBLIC_URL=http://localhost:4000
# Nombre de proxys de confiance devant l'API (0 = aucun ; 1 = un reverse proxy). Impacte req.ip et le rate limiting.
TRUST_PROXY_HOPS=0

# JWT d'accès (HS256) : secret aléatoire de 256 bits minimum (≥ 43 caractères base64url)
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_43_RANDOM_CHARACTERS_XXXXXXXXXXXX
JWT_ISSUER=nuits-api
JWT_AUDIENCE=nuits-web
# Cookie du refresh token avec l'attribut Secure (OBLIGATOIREMENT true en production ; false seulement en dev HTTP)
REFRESH_COOKIE_SECURE=false

# Chiffrement au repos des IBAN (AES-256-GCM) : exactement 32 octets encodés en base64
DATA_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64_XXXXXXXXXXXXXXXXXXX=

# Clés Ed25519 de signature des billets (générées par `npm run keys:generate`, dossier gitignoré)
TICKET_SIGNING_PRIVATE_KEY_FILE=keys/ticket-signing-private.pem
TICKET_SIGNING_PUBLIC_KEY_FILE=keys/ticket-signing-public.pem

# SMTP (Mailpit en dev : UI sur http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Les Nuits de la Garonne <billetterie@nuits-garonne.test>"

# Prestataire de paiement (mock en dev/test, jamais démarré en production)
PSP_BASE_URL=http://localhost:4001
PSP_PORT=4001
# Clé d'API backend -> PSP (≥ 32 caractères)
PSP_API_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS_XX
# Secret HMAC des webhooks PSP -> backend (≥ 32 caractères)
PSP_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS_XX
# URL de webhook appelée par le mock PSP
PSP_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/psp

# Worker : période de scrutation (expirations, outbox mail, remboursements), en ms
WORKER_INTERVAL_MS=5000

# Seed : mot de passe commun des comptes de démonstration (≥ 12 caractères).
# Laisser vide pour qu'un mot de passe aléatoire soit généré et affiché une seule fois.
SEED_PASSWORD=
